    "sphinx-source-file-count-plural": {
      "state": "open",
      "draft": false,
      "merged_at": null,
      "closed_at": null,
      "updated_at": "2026-05-28T22:11:48Z",
      "title": "fix: use correct singular/plural forms for source file count strings",
      "html_url": "https://github.com/sphinx-doc/sphinx/pull/14456",
      "head_sha": "373dbe88d12972fdd67ece8acd7f55227d51795e",
      "head_short": "373dbe88",
      "comments": 0,
      "review_comments": 0,
      "commits_count": 1,
      "latest_commit": "373dbe88d12972fdd67ece8acd7f55227d51795e",
      "latest_commit_msg": "fix: use correct singular/plural forms for source file count strings\n\nThe build_specific and build_update summary messages used hardcoded\nplural strings even when the count was 1, producing grammar errors\nlike \"1 source files given on command line\".\n\nThis fix uses conditional string selection to produce correct\nsingular/plural forms based on the actual file count.\n\nFixes #12903",
      "latest_commit_author": "Jay",
      "latest_commit_date": "2026-05-28T22:11:47Z",
      "commits": [
        {
          "sha": "373dbe88d12972fdd67ece8acd7f55227d51795e",
          "message": "fix: use correct singular/plural forms for source file count strings\n\nThe build_specific and build_update summary messages used hardcoded\nplural strings even when the count was 1, producing grammar errors\nlike \"1 source files given on command line\".\n\nThis fix uses conditional string selection to produce correct\nsingular/plural forms based on the actual file count.\n\nFixes #12903",
          "author": "Jay",
          "date": "2026-05-28T22:11:47Z"
        }
      ],
